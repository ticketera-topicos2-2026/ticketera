# =============================================================================
# .env.example  -  Plantilla de la configuración local (Docker Compose)
#
# - Copiala a .env (cp .env.example .env). Git ignora .env; nunca lo subas.
# - Este archivo es público: solo lleva valores de ejemplo, nunca secretos reales
#   (RB-02, spec local-environment). Los valores sirven tal cual en local y en la CI.
# - Cada variable obligatoria se usa en docker-compose.yml con ${VAR:?mensaje}:
#   si falta o está vacía, Compose se detiene antes de crear contenedores y la
#   nombra (DS-16).
# - Cada grupo del bootstrap agrega aquí las variables que necesita.
# =============================================================================

# Base de datos (PostgreSQL): administrador. Ningún servicio se conecta con él;
# cada servicio tiene su propio rol y su propia base (DS-02).
POSTGRES_USER=ticketera_admin
POSTGRES_PASSWORD=local-postgres-admin-password

# Contraseñas de los roles de los servicios en la base de datos. Cada rol se llama
# como su base (catalog, sales, payments, keycloak) y el script de
# infra/database/ lo crea con la contraseña de su variable (DS-02).
CATALOG_DB_PASSWORD=local-catalog-db-password
SALES_DB_PASSWORD=local-sales-db-password
PAYMENTS_DB_PASSWORD=local-payments-db-password
KEYCLOAK_DB_PASSWORD=local-keycloak-db-password

# Puerto del gateway en 127.0.0.1: la única entrada a la API y a /auth (DS-10).
# Lo usa también la URL pública del servicio de identidad (KC_HOSTNAME).
GATEWAY_PORT=18080

# Administrador inicial del servicio de identidad. Se crea solo en el primer
# arranque; para cambiarlo hace falta docker compose down -v o la consola.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-keycloak-admin-password

# Contraseñas de los usuarios de prueba del realm ticketera, uno por rol de la
# plataforma: test-admin, test-event-owner y test-client. El servicio de
# identidad las carga solo cuando importa el realm, es decir, cuando no existe:
# para cambiarlas hace falta docker compose down -v (IA-11).
TEST_USER_ADMIN_PASSWORD=local-test-admin-password
TEST_USER_EVENT_OWNER_PASSWORD=local-test-event-owner-password
TEST_USER_CLIENT_PASSWORD=local-test-client-password

# Origen del frontend: el único que puede llamar a la API desde el navegador
# (CORS, DS-09). Debe coincidir con la dirección en la que se abre el frontend.
# También fija las direcciones de retorno del inicio de sesión en el realm
# ticketera: si lo cambiás, hace falta docker compose down -v (IA-11).
FRONTEND_ORIGIN=http://localhost:5173

# Puerto del frontend en 127.0.0.1 (DS-10). Si lo cambiás, cambiá también el
# puerto de FRONTEND_ORIGIN, o el navegador va a recibir errores de CORS.
FRONTEND_PORT=5173

# Opcional: VITE_USE_POLLING=true hace que Vite revise los archivos por sondeo,
# por si los cambios no llegan al contenedor (DS-17).
# VITE_USE_POLLING=true

# Opcionales: tu UID y tu GID en WSL (id -u, id -g), para que los archivos que
# crean los contenedores en las carpetas montadas sean tuyos (DS-13). Si no los
# definís, valen 1000, el primer usuario de una distribución de WSL. Después de
# cambiarlos, reconstruí las imágenes con docker compose up --build.
# HOST_UID=1000
# HOST_GID=1000
