# Gateway: the only entry point to the API and to the identity service (DS-07; Req api-gateway).
#
# The image's entrypoint renders this template into /etc/nginx/conf.d/default.conf, replacing the image's default
# server; each ${NAME} that names an environment variable is replaced with its value.
#
# Change project-bootstrap, task group 2 (design: platform/api-gateway); the access check: change e1-identity-access,
# task 1.10 (IA-01 to IA-04, IA-09).

# Hides the NGINX version in the Server header and in error pages, those of the 421 default server included: the
# version is an internal detail that helps an attacker look up known vulnerabilities (design, Security Threat
# Analysis: Information disclosure). This file is included in the http context, so it applies to both servers.
server_tokens off;

# Access log: one JSON line per request on standard output (change e1-request-log, RL-01, RL-09; Req api-gateway: The
# gateway writes one JSON access log line per request; The gateway access log line has a fixed set of fields).
# escape=json escapes quotes, backslashes and control characters in every value, so no request can break a line or
# add a field. $status and $request_time are written without quotes: they are JSON numbers. $request_id is the
# correlation id, 32 random hexadecimal characters that the gateway generates for every request (RL-01).
# Rule from e1-identity-access (IA-08), kept here: never log $request, $args, $query_string, $request_uri,
# $http_authorization, $http_referer or any other client header; $uri is the normalized path without the query
# string (Req api-gateway: The gateway access log keeps tokens and the query string out).
log_format ticketera_json escape=json
    '{"timestamp":"$time_iso8601","service":"gateway","correlation_id":"$request_id",'
    '"method":"$request_method","path":"$uri","status":$status,"duration_seconds":$request_time,'
    '"client_address":"$remote_addr"}';

# CORS for the API (DS-09; Req api-gateway: The frontend can call the API from the browser). The only allowed
# origin is the frontend's, FRONTEND_ORIGIN in .env, substituted when the template is rendered. Any other origin
# maps to an empty value, and NGINX sends no header whose value is empty, so it gets no permission: neither a
# wildcard nor its own origin echoed back.
map $uri $is_api_request {
    default 0;
    ~^/api/ 1;
}

map "$is_api_request:$http_origin" $cors_allow_origin {
    default "";
    "1:${FRONTEND_ORIGIN}" "${FRONTEND_ORIGIN}";
}

# Vary: Origin on every API response, so a cache never serves a response to another origin.
map $is_api_request $cors_vary {
    default "";
    1 Origin;
}

# A CORS preflight under /api/, which the gateway answers itself and never forwards.
map "$request_method:$is_api_request" $is_api_preflight {
    default 0;
    "OPTIONS:1" 1;
}

# Public requests skip the access check (IA-03; Req api-gateway: Public paths skip the access check): only GET and
# HEAD of /api/<service>/health, with or without a query string. The decision is taken in the /_auth subrequest,
# where $uri is /_auth, so it reads $request_method, always the main request's, and $request_uri, the raw URI that
# the subrequest shares with the main request. The pattern allows no dot, percent sign or empty segment, so whenever
# the raw URI matches, the path NGINX routes on is that same health path; any other spelling stays protected.
map "$request_method:$request_uri" $is_public_request {
    default 0;
    "~^(GET|HEAD):/api/[a-z0-9-]+/health(\?.*)?$" 1;
}

# An Authorization header that holds a bearer token as RFC 6750 defines it, with the scheme in any case (IA-04).
map $http_authorization $has_bearer_token {
    default 0;
    "~*^Bearer +[A-Za-z0-9._~+/-]+=*$" 1;
}

# The challenge of a 401 that has none yet (IA-04): the 401 the gateway answers for a request without a bearer
# token. When the identity service rejects a token, auth_request already copies its challenge (Bearer, with the
# error), and a service that answers 401 sends its own, so every 401 carries exactly one WWW-Authenticate header.
map "$status:$sent_http_www_authenticate" $bearer_challenge {
    default "";
    "401:" Bearer;
}

# Any other Host gets 421 without being forwarded, which defeats DNS rebinding (Req api-gateway: The gateway serves
# only the expected host names).
server {
    listen 8080 default_server;
    # Rejected host names are logged and correlated too (Req api-gateway: Scenario: Unexpected host name).
    access_log /var/log/nginx/access.log ticketera_json;
    add_header X-Correlation-ID $request_id always;
    return 421;
}

server {
    listen 8080;
    # server_name matches the host name without the port, so "localhost:<port>" from the browser is served; the
    # container healthcheck uses 127.0.0.1.
    server_name localhost 127.0.0.1;

    # The image's access.log is a link to standard output; this replaces the image's "main" format, which logs the
    # query string.
    access_log /var/log/nginx/access.log ticketera_json;

    # The correlation id goes back to the client on every answer, those the gateway gives itself included (Req
    # request-correlation: The gateway gives every request a correlation id). A location that declares its own
    # add_header stops inheriting this one, so route files never use add_header (DS-09).
    add_header X-Correlation-ID $request_id always;

    # CORS headers of the API, sent with every status code. A location that declares its own add_header stops
    # inheriting these, so route files never use add_header.
    add_header Access-Control-Allow-Origin $cors_allow_origin always;
    add_header Vary $cors_vary always;
    add_header WWW-Authenticate $bearer_challenge always;

    # Access check (IA-01; Req api-gateway: Requests forwarded on paths that are not public require a valid access
    # token): every location inherits it, those of routes added later included, and forwards a request only when the
    # /_auth subrequest answers 2xx; a 401 or a 403 of the subrequest is answered to the client as 401 (see /_auth).
    # Requests the gateway answers itself in the rewrite phase (the preflight, /healthz, the 404 of location / and
    # the /auth/health and /auth/metrics blocks) end before the access phase, so they need no token. location /auth/
    # turns it off (identity.conf).
    auth_request /_auth;

    # Answered before any location is chosen, so the preflight never reaches a service.
    if ($is_api_preflight) {
        return 204;
    }

    # Req api-gateway: The gateway reports its own health.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The subrequest of the access check (IA-02, IA-04). It is internal, so no client can request it, and NGINX runs
    # no access check for a subrequest. Public requests are allowed and a request without a bearer token is refused
    # here, without asking the identity service; any other asks userinfo by its internal name, which works because
    # KC_HOSTNAME fixes the issuer. userinfo receives the client's Authorization header unchanged and nothing of the
    # request itself: the subrequest has no query string and its URI is replaced, the body is not passed, the
    # method is GET (NGINX makes every subrequest a GET; proxy_method states it explicitly), and Content-Type and
    # Cookie are cleared. NGINX keeps no cache of the result: every request is checked.
    location = /_auth {
        internal;
        if ($is_public_request) {
            return 204;
        }
        if ($has_bearer_token = 0) {
            return 401;
        }
        proxy_pass http://identity:8080/auth/realms/ticketera/protocol/openid-connect/userinfo;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Content-Type "";
        proxy_set_header Cookie "";
        include snippets/forwarded-headers.conf;
        # Every 4xx of userinfo, such as the 403 for a token without the openid scope, becomes 401, so that a
        # rejected token never looks like a role denial (IA-04; Req api-gateway: A token rejected by the identity
        # service is answered 401).
        proxy_intercept_errors on;
        error_page 400 401 402 403 404 405 406 407 408 409 410 411 412 413 414 415 416 417 421 422 423 424 425 426
            428 429 431 451 = @access_token_rejected;
    }

    location @access_token_rejected {
        return 401;
    }

    # One route file per service, infra/gateway/routes/<service>.conf, mounted at routes/platform; test-only routes
    # are mounted in a sibling folder (task 2.12).
    include routes/*/*.conf;

    # Req api-gateway: Requests that match no route are rejected.
    location / {
        return 404;
    }
}
