{
  "uid": "request-log",
  "title": "Request log",
  "description": "HTTP request log of the gateway and the backend services (change e1-request-log, D-23). Only requests that came through the gateway are counted: they carry a correlation id, the container healthchecks do not.",
  "tags": ["ticketera", "request-log"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "correlation_id",
        "label": "Correlation id",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""},
        "description": "Paste the X-Correlation-ID of a response to see every line of that request."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per service",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (service) (count_over_time({service=~\".+\"} | json | __error__=\"\" | correlation_id != \"\" [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per status class",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (status_class) (count_over_time({service=~\".+\"} | json | __error__=\"\" | correlation_id != \"\" | label_format status_class=`{{ substr 0 1 .status }}xx` [$__auto]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration percentiles per service (p50, p95, p99)",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 9},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "quantile_over_time(0.50, {service=~\".+\"} | json | __error__=\"\" | correlation_id != \"\" | unwrap duration_seconds [$__auto]) by (service)",
          "legendFormat": "p50 {{service}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "quantile_over_time(0.95, {service=~\".+\"} | json | __error__=\"\" | correlation_id != \"\" | unwrap duration_seconds [$__auto]) by (service)",
          "legendFormat": "p95 {{service}}"
        },
        {
          "refId": "C",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "quantile_over_time(0.99, {service=~\".+\"} | json | __error__=\"\" | correlation_id != \"\" | unwrap duration_seconds [$__auto]) by (service)",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Lines of the request with the chosen correlation id",
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service=~\".+\"} |= \"$correlation_id\""
        }
      ]
    }
  ]
}
