#!/bin/sh
# Applies the schema migrations, then starts the API with reload on source changes (D-33, DS-17), without
# the Uvicorn access line: the request log middleware writes the only line per request (e1-request-log).
set -e
alembic upgrade head
exec uvicorn catalog.api.main:app --app-dir src --host 0.0.0.0 --port 8000 --no-access-log --reload --reload-dir src
