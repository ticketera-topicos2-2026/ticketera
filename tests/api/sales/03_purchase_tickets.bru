meta {
  name: 3. Purchase Tickets (Idempotent)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/events/{{eventId}}/orders
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: 11111111-2222-3333-4444-555555555555
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "seat_ids": [
      "SEAT-1"
    ]
  }
}

assert {
  res.status: eq 201
  res.body.order_id: isDefined
  res.body.status: eq "CONFIRMED"
}
