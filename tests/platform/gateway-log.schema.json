{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway access log line",
  "description": "One line of the gateway access log (change e1-request-log; Req api-gateway: The gateway access log line has a fixed set of fields). Checked by scripts/check_log_lines.py, which supports only the keywords used here.",
  "type": "object",
  "required": ["timestamp", "service", "correlation_id", "method", "path", "status", "duration_seconds", "client_address"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "service": {"const": "gateway"},
    "correlation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "method": {"type": "string"},
    "path": {"type": "string"},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "duration_seconds": {"type": "number", "minimum": 0},
    "client_address": {"type": "string"}
  }
}
