{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service request log line",
  "description": "One request log line of a backend service (change e1-request-log; Req request-log: The request log line has a fixed set of fields). Checked by scripts/check_log_lines.py, which supports only the keywords used here.",
  "type": "object",
  "required": ["timestamp", "service", "correlation_id", "method", "route", "status", "duration_seconds", "user_id"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "service": {"enum": ["catalog", "sales", "payments"]},
    "correlation_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
    "method": {"type": "string"},
    "route": {"type": ["string", "null"]},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "duration_seconds": {"type": "number", "minimum": 0},
    "user_id": {"type": ["string", "null"]}
  }
}
